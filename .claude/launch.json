{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gmao-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "gmao-mobile-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd mobile && flutter run -d web-server --web-port=5080 --dart-define=API_BASE_URL=http://127.0.0.1:8000/api --dart-define=API_ORIGIN=http://127.0.0.1:8000"
      ],
      "port": 5080
    }
  ]
}
